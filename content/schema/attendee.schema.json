{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rounds.dijmo.com/schema/attendee.schema.json",
  "title": "Attendee",
  "description": "A meeting attendee, from a template or the user's setup form.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "role", "cares_about", "personality", "likely_objections"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 24 },
    "role": { "type": "string", "minLength": 1, "maxLength": 48 },
    "cares_about": { "type": "array", "maxItems": 5, "items": { "type": "string", "minLength": 1 } },
    "personality": { "enum": ["supportive", "neutral", "skeptical", "hostile"] },
    "likely_objections": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1 },
      "description": "Empty = generated before the session from role, cares_about and the goal."
    },
    "decision_power": { "enum": ["approver", "influencer", "observer"], "default": "influencer" },
    "knows": { "type": "string", "description": "What this person has already seen." },
    "voice_base": { "type": "string", "pattern": "^persona\\.[a-z]+$", "description": "Persona whose voice and avatar this attendee borrows." }
  }
}
