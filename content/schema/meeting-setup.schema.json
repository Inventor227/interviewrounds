{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rounds.dijmo.com/schema/meeting-setup.schema.json",
  "title": "MeetingSetup",
  "description": "What the user submits to POST /api/meetings/prepare.",
  "type": "object",
  "additionalProperties": false,
  "required": ["template_id", "goal", "user_role", "attendees", "length", "difficulty"],
  "properties": {
    "template_id": {
      "enum": ["investor_pitch", "client_proposal", "exec_update", "salary_negotiation", "performance_review", "project_kickoff", null],
      "description": "null = custom meeting."
    },
    "goal": { "type": "string", "minLength": 1, "maxLength": 200 },
    "user_role": { "type": "string", "minLength": 1, "maxLength": 80 },
    "attendees": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "attendee.schema.json" } },
    "length": { "enum": ["short", "full"] },
    "key_facts": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1 } },
    "ask": { "type": "string" },
    "walk_away": { "type": "string" },
    "notes": { "type": "string", "maxLength": 8000 },
    "difficulty": { "enum": ["friendly", "realistic", "tough"], "default": "realistic" }
  }
}
