{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rounds.dijmo.com/schema/report.v1.schema.json",
  "title": "SessionReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session", "headline", "competencies", "evidence", "strengths", "weaknesses", "weakest_moment", "next_drills", "delivery"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode", "round_type", "length", "seniority", "difficulty", "duration_sec", "ended_by", "coverage"],
      "properties": {
        "id": { "type": "string" },
        "mode": { "enum": ["interview", "meeting"] },
        "role": { "enum": ["sde", "pm", "none"] },
        "round_id": { "type": "string", "description": "Round config id, e.g. sde.system_design.short." },
        "round_type": { "enum": ["coding", "system_design", "object_design", "behavioral", "recruiter_screen", "pm_product_sense", "pm_execution", "pm_estimation", "pm_strategy", "pm_leadership", "meeting"] },
        "length": { "enum": ["short", "full"] },
        "seniority": { "enum": ["junior", "mid", "senior", "staff", "n/a"] },
        "difficulty": { "enum": ["easy", "standard", "hard"] },
        "question_id": { "type": "string" },
        "personas": { "type": "array", "items": { "type": "string" } },
        "started_at": { "type": "string", "format": "date-time" },
        "duration_sec": { "type": "integer", "minimum": 0 },
        "ended_by": { "enum": ["completed", "user_ended", "time_limit", "disconnected", "headset_removed"] },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "phases_planned": { "type": "array", "items": { "type": "string" } },
            "phases_completed": { "type": "array", "items": { "type": "string" } },
            "pct": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "headline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": { "type": "string", "maxLength": 140 },
        "verdict": {
          "type": ["object", "null"],
          "description": "Null in meeting mode, and null when there is not enough signal (summary then says so).",
          "additionalProperties": false,
          "required": ["label", "index", "is_provisional", "confidence"],
          "properties": {
            "label": { "enum": ["strong_no_hire", "no_hire", "leaning_no_hire", "leaning_hire", "hire", "strong_hire"] },
            "index": { "type": "integer", "minimum": 1, "maximum": 6 },
            "is_provisional": { "type": "boolean", "description": "True for short rounds: shown as 'Signal so far'." },
            "confidence": { "enum": ["low", "medium", "high"] },
            "rationale": { "type": "string", "maxLength": 300 }
          }
        },
        "overall_score": { "type": ["number", "null"], "minimum": 1, "maximum": 4 }
      }
    },
    "competencies": {
      "type": "array", "minItems": 3, "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "score", "rationale", "evidence_ids"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "score": { "type": ["integer", "null"], "minimum": 1, "maximum": 4 },
          "level_label": { "enum": ["below", "developing", "meets_bar", "above_bar", "not_observed"] },
          "weight": { "type": "number", "default": 1 },
          "rationale": { "type": "string", "maxLength": 300 },
          "evidence_ids": { "type": "array", "items": { "type": "string" } },
          "delta_vs_last": { "type": ["number", "null"] }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "t_start_sec", "speaker", "quote", "polarity"],
        "properties": {
          "id": { "type": "string" },
          "t_start_sec": { "type": "number" },
          "t_end_sec": { "type": "number" },
          "speaker": { "type": "string", "description": "'user' or a persona id" },
          "quote": { "type": "string", "maxLength": 400 },
          "polarity": { "enum": ["positive", "negative", "neutral"] },
          "competency_ids": { "type": "array", "items": { "type": "string" } },
          "note": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "strengths": { "$ref": "#/$defs/points" },
    "weaknesses": { "$ref": "#/$defs/points" },
    "weakest_moment": {
      "type": ["object", "null"],
      "description": "Null when there is not enough signal.",
      "additionalProperties": false,
      "required": ["question", "t_start_sec", "what_happened", "strong_answer_covers", "model_answer"],
      "properties": {
        "question": { "type": "string" },
        "t_start_sec": { "type": "number" },
        "what_happened": { "type": "string", "maxLength": 300 },
        "strong_answer_covers": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "string" } },
        "model_answer": { "type": "string", "maxLength": 900, "description": "Spoken style, 20-40 seconds." },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prompt": { "type": "string" },
            "max_seconds": { "type": "integer", "default": 120 }
          }
        },
        "retries": {
          "type": "array",
          "description": "One entry per retry session of this moment, oldest first.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["session_id", "at", "before_score", "after_score", "note"],
            "properties": {
              "session_id": { "type": "string", "description": "The retry session (its parent_session_id is this report's session)." },
              "at": { "type": "string", "format": "date-time" },
              "before_score": { "type": ["number", "null"], "minimum": 1, "maximum": 4 },
              "after_score": { "type": ["number", "null"], "minimum": 1, "maximum": 4 },
              "note": { "type": "string", "maxLength": 300, "description": "What improved or what is still missing." }
            }
          }
        }
      }
    },
    "next_drills": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "why", "kind", "est_minutes"],
        "properties": {
          "title": { "type": "string", "maxLength": 80 },
          "why": { "type": "string", "maxLength": 200 },
          "kind": { "enum": ["retry_answer", "short_round", "full_round", "meeting", "concept_review"] },
          "round_type": { "type": "string" },
          "round_id": { "type": "string" },
          "question_id": { "type": "string" },
          "est_minutes": { "type": "integer" }
        }
      }
    },
    "delivery": {
      "type": "object",
      "description": "Computed by the server, not the model. Timing fields are null when the session had no audio timing.",
      "additionalProperties": false,
      "properties": {
        "wpm": { "type": ["number", "null"] },
        "wpm_band": { "enum": ["slow", "good", "fast", null] },
        "filler_per_min": { "type": ["number", "null"] },
        "filler_band": { "enum": ["good", "okay", "work_on_it", null] },
        "filler_top": { "type": "array", "items": { "type": "object", "additionalProperties": false, "properties": { "word": { "type": "string" }, "count": { "type": "integer" } } } },
        "long_pauses": { "type": "array", "items": { "type": "object", "additionalProperties": false, "properties": { "t_sec": { "type": "number" }, "dur_sec": { "type": "number" } } } },
        "talk_ratio_user": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "answers": { "type": "array", "items": { "type": "object", "additionalProperties": false, "properties": { "t_start_sec": { "type": "number" }, "dur_sec": { "type": "number" }, "flag": { "enum": ["ok", "short", "long"] } } } },
        "gaze_on_speaker_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "user_interruptions": { "type": ["integer", "null"] },
        "hints": { "type": "array", "items": { "type": "object", "additionalProperties": false, "properties": { "level": { "type": "integer", "minimum": 1, "maximum": 5 }, "t_sec": { "type": "number" }, "accepted": { "type": "boolean" } } } }
      }
    },
    "round_details": {
      "description": "Extra fields per round type.",
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "coding" }, "time_complexity": { "type": "string" }, "space_complexity": { "type": "string" }, "optimal_reached": { "type": "boolean" }, "blocks_correct_pct": { "type": "number" }, "edge_cases_named": { "type": "array", "items": { "type": "string" } }, "found_own_bug": { "type": "boolean" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "enum": ["system_design", "object_design"] }, "board_image_url": { "type": "string" }, "board_as_text": { "type": "string" }, "requirements_captured": { "type": "array", "items": { "type": "string" } }, "tradeoffs_discussed": { "type": "array", "items": { "type": "string" } }, "missing_components": { "type": "array", "items": { "type": "string" } } } },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "behavioral" }, "stories": { "type": "array", "items": { "type": "object", "additionalProperties": false, "properties": { "title": { "type": "string" }, "situation": { "type": "boolean" }, "action": { "type": "boolean" }, "result": { "type": "boolean" }, "quantified": { "type": "boolean" }, "scope": { "enum": ["task", "team", "multi_team", "org"] } } } } } },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "pm" }, "frameworks_used": { "type": "array", "items": { "type": "string" } }, "metrics_proposed": { "type": "array", "items": { "type": "string" } }, "final_estimate": { "type": "string" } } },
        { "$ref": "#/$defs/meeting" }
      ]
    },
    "share": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "public_slug": { "type": ["string", "null"] }, "include_quotes": { "type": "boolean", "default": false } }
    }
  },
  "$defs": {
    "points": {
      "type": "array", "minItems": 0, "maxItems": 3,
      "description": "Empty only when there is not enough signal.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "detail", "evidence_ids"],
        "properties": {
          "title": { "type": "string", "maxLength": 60 },
          "detail": { "type": "string", "maxLength": 240 },
          "evidence_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "meeting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "meeting" },
        "template": { "enum": ["investor_pitch", "client_proposal", "exec_update", "salary_negotiation", "performance_review", "project_kickoff", "custom"] },
        "goal": { "type": "string" },
        "outcome": { "enum": ["approved", "approved_with_conditions", "need_more_info", "not_now"] },
        "goal_reached": { "enum": ["yes", "partly", "no"] },
        "decision_quote_id": { "type": "string" },
        "ask_made": { "type": "boolean" },
        "stayed_above_walkaway": { "type": ["boolean", "null"] },
        "next_steps": { "type": "array", "items": { "type": "object", "additionalProperties": false, "properties": { "owner": { "type": "string" }, "action": { "type": "string" }, "due": { "type": "string" } } } },
        "attendees": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" },
              "stance_start": { "type": "integer", "minimum": -2, "maximum": 2 },
              "stance_end": { "type": "integer", "minimum": -2, "maximum": 2 },
              "stance_timeline": { "type": "array", "items": { "type": "object", "additionalProperties": false, "properties": { "t_sec": { "type": "number" }, "stance": { "type": "integer" }, "why": { "type": "string" } } } },
              "concerns": { "type": "array", "items": { "type": "object", "additionalProperties": false, "properties": { "concern": { "type": "string" }, "status": { "enum": ["resolved", "partly", "open"] }, "evidence_ids": { "type": "array", "items": { "type": "string" } } } } },
              "one_line": { "type": "string", "description": "What this person will say about you after the meeting." }
            }
          }
        },
        "objections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "by": { "type": "string" },
              "t_sec": { "type": "number" },
              "objection": { "type": "string" },
              "handled": { "enum": ["well", "partly", "poorly", "not_addressed"] },
              "better_response": { "type": "string", "maxLength": 400 }
            }
          }
        }
      }
    }
  }
}
