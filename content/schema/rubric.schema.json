{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rounds.dijmo.com/schema/rubric.schema.json",
  "title": "Rubric",
  "description": "One file per rubric in content/rubrics/. Scores 1 to 4 per competency, judged against the chosen level.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "round_types",
    "title",
    "scale",
    "level_bar",
    "competencies",
    "scoring_notes",
    "red_flags"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^rubric\\.[a-z_]+$"
    },
    "round_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "coding",
          "system_design",
          "object_design",
          "behavioral",
          "recruiter_screen",
          "pm_product_sense",
          "pm_execution",
          "pm_estimation",
          "pm_strategy",
          "pm_leadership",
          "meeting"
        ]
      }
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "1",
        "2",
        "3",
        "4"
      ],
      "properties": {
        "1": {
          "$ref": "#/$defs/scale_step"
        },
        "2": {
          "$ref": "#/$defs/scale_step"
        },
        "3": {
          "$ref": "#/$defs/scale_step"
        },
        "4": {
          "$ref": "#/$defs/scale_step"
        }
      }
    },
    "level_bar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "junior",
        "mid",
        "senior",
        "staff"
      ],
      "properties": {
        "junior": {
          "type": "string",
          "minLength": 1
        },
        "mid": {
          "type": "string",
          "minLength": 1
        },
        "senior": {
          "type": "string",
          "minLength": 1
        },
        "staff": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "competencies": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "weight",
          "looks_for",
          "descriptors"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "looks_for": {
            "type": "string",
            "minLength": 1
          },
          "descriptors": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "1",
              "2",
              "3",
              "4"
            ],
            "properties": {
              "1": {
                "type": "string",
                "minLength": 1
              },
              "2": {
                "type": "string",
                "minLength": 1
              },
              "3": {
                "type": "string",
                "minLength": 1
              },
              "4": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "scoring_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "red_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "scale_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "name",
        "meaning"
      ],
      "properties": {
        "label": {
          "enum": [
            "below",
            "developing",
            "meets_bar",
            "above_bar"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
