{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rounds.dijmo.com/schema/meeting-template.schema.json",
  "title": "MeetingTemplate",
  "description": "One file per template in content/meeting-templates/, named <id>.json. Fills the meeting setup form.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "summary", "goal", "your_role", "scenario", "attendees", "hidden_concerns", "success", "tips"],
  "properties": {
    "id": { "enum": ["investor_pitch", "client_proposal", "exec_update", "salary_negotiation", "performance_review", "project_kickoff"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 40 },
    "summary": { "type": "string", "maxLength": 140, "description": "One line on the template picker." },
    "goal": { "type": "string", "minLength": 1, "description": "Default answer to: what do you want them to decide or do?" },
    "your_role": { "type": "string", "minLength": 1 },
    "scenario": { "type": "string", "minLength": 1, "description": "Pre-filled example situation." },
    "attendees": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "attendee.schema.json" } },
    "hidden_concerns": { "type": "array", "items": { "type": "string" }, "description": "What the attendees will probe (prompt text)." },
    "success": { "type": "string", "minLength": 1, "description": "What a good outcome looks like." },
    "tips": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string" }, "description": "How to win this meeting, shown before start." },
    "key_facts": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "value"],
        "properties": { "label": { "type": "string", "minLength": 1 }, "value": { "type": "string", "minLength": 1 } }
      }
    },
    "ask": { "type": "string", "description": "What the user will ask for." },
    "walk_away": { "type": ["string", "null"], "description": "Negotiations: the user's floor." },
    "difficulty": { "enum": ["friendly", "realistic", "tough"], "default": "realistic" },
    "who_speaks_first": { "enum": ["user", "chair"], "default": "user" },
    "length": { "enum": ["short", "full"], "default": "short" },
    "user_chairs": { "type": "boolean", "default": false, "description": "True = the user runs the meeting (e.g. a performance review); no AI attendee chairs." }
  }
}
