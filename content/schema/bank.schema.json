{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rounds.dijmo.com/schema/bank.schema.json",
  "title": "QuestionBank",
  "description": "One file per round type in content/banks/: the question cards a round draws from.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "round_type",
    "title",
    "cards"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^bank\\.[a-z_]+$"
    },
    "round_type": {
      "enum": [
        "coding",
        "system_design",
        "object_design",
        "behavioral",
        "recruiter_screen",
        "pm_product_sense",
        "pm_execution",
        "pm_estimation",
        "pm_strategy",
        "pm_leadership",
        "meeting"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "cards": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "round_type",
          "title",
          "levels",
          "lengths",
          "prompt",
          "strong_answer_covers",
          "red_flags"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+\\.[a-z0-9_]+$"
          },
          "round_type": {
            "enum": [
              "coding",
              "system_design",
              "object_design",
              "behavioral",
              "recruiter_screen",
              "pm_product_sense",
              "pm_execution",
              "pm_estimation",
              "pm_strategy",
              "pm_leadership",
              "meeting"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48
          },
          "levels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "junior",
                "mid",
                "senior",
                "staff",
                "n/a"
              ]
            }
          },
          "lengths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "short",
                "full"
              ]
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "brief_lines": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "facts_if_asked": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "follow_ups": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "twist": {
            "type": "string",
            "minLength": 1
          },
          "hints": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Hint ladder levels 1 to 4."
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "success_prompt": {
            "type": "string",
            "minLength": 1
          },
          "diagnosis_prompt": {
            "type": "string",
            "minLength": 1
          },
          "template_id": {
            "type": "string",
            "minLength": 1
          },
          "strong_answer_covers": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "red_flags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reference_solution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "language",
              "time",
              "space",
              "lines",
              "distractors"
            ],
            "properties": {
              "language": {
                "type": "string",
                "minLength": 1
              },
              "time": {
                "type": "string",
                "minLength": 1
              },
              "space": {
                "type": "string",
                "minLength": 1
              },
              "lines": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "indent",
                    "text"
                  ],
                  "properties": {
                    "indent": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 6
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "distractors": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "indent",
                    "text"
                  ],
                  "properties": {
                    "indent": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 6
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
