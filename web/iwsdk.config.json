{
  "$schema": "./node_modules/@iwsdk/core/dist/schemas/iwsdk-project.v1.schema.json",
  "version": "iwsdk.project.v1",
  "scene": "./public/scenes/room.iwsdk.scene.json",
  "world": {
    "xr": {
      "mode": "ar",
      "offer": "none",
      "features": {
        "handTracking": { "required": true },
        "hitTest": true,
        "anchors": true
      }
    },
    "input": { "canvasPointerEvents": true },
    "render": { "near": 0.01, "far": 50 },
    "features": {
      "environmentRaycast": true,
      "spatialUI": { "kit": "horizon", "preferredColorScheme": "dark" }
    }
  },
  "dev": {
    "emulator": { "device": "metaQuest3", "environment": "home_office" }
  }
}
